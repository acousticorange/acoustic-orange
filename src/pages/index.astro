---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Games</h1>
			<div style="margin: 2rem 0; padding: 2rem; border: 2px solid #0f0; background: #001100; border-radius: 8px;">
				<h2 style="color: #0f0; margin-bottom: 1rem;">Choplifter</h2>
				<p style="color: #0a0; margin-bottom: 1rem;">
					A mobile-friendly recreation of the classic 1982 Apple II Plus game.
					Pilot your helicopter behind enemy lines to rescue hostages!
				</p>
				<a href="/choplifter" style="display: inline-block; padding: 12px 24px; background: #0f0; color: #000; text-decoration: none; font-weight: bold; border-radius: 4px;">
					PLAY NOW
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
